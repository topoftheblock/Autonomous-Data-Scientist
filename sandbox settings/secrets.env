# config/secrets.env
# Sensitive API keys and credentials for the Autonomous Data Science Agent.
# Copy this to config/secrets.env and fill in your real values.
# NEVER commit this file to Git!

# OpenAI (required for GPT‑4o / GPT‑4o‑mini)
OPENAI_API_KEY=sk-...

# Optional: other LLM providers
# ANTHROPIC_API_KEY=sk-ant-...
# TOGETHER_API_KEY=...
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Optional: LangSmith tracing (debugging)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls_...
# LANGCHAIN_PROJECT=autonomous-ds-agent